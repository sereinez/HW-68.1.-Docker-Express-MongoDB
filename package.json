{
  "name": "express-docker-app",
  "version": "1.0.0",
  "description": "Express + MongoDB у Docker (Dockerfile, Docker Compose, hot reload); Passport, курсори, агрегації, PUG + EJS",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:large": "node scripts/seed-large.js",
    "seed:clear": "node scripts/clear-large.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "serve-favicon": "^2.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}

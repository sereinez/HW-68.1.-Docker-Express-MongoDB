# ==========================================================================
# Образ для Express-додатка. Збірка:  docker build -t express-app .
# ==========================================================================

# Офіційний образ Node.js (LTS — версія з довгостроковою підтримкою)
FROM node:lts

# Робоча директорія всередині контейнера: усі наступні команди виконуються в ній
WORKDIR /app

# Спершу копіюємо ЛИШЕ файли залежностей. Docker кешує кожен крок: поки package*.json
# не змінилися, крок з встановленням залежностей береться з кешу, і повторна збірка
# займає секунди, а не хвилини.
COPY package*.json ./

# Встановлення залежностей точно за package-lock.json (відтворювана збірка)
RUN npm ci

# Копіюємо решту файлів проєкту (зайве — node_modules, .env, .git — відсікає .dockerignore)
COPY . .

# Документуємо, що додаток слухає порт 3000 (публікує порт на хост docker-compose.yml)
EXPOSE 3000

# Не запускаємо додаток від імені root — користувач node вже є в образі node:lts
USER node

# Команда запуску додатка
CMD ["node", "src/server.js"]
